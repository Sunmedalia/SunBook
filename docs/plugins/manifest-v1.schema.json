{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sunmedalia/SunBook/main/docs/plugins/manifest-v1.schema.json",
  "title": "SunBook Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "command",
    "commands"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "apiVersion": {
      "const": 1
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "permissions": {
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true,
      "items": {
        "enum": [
          "document.read",
          "document.edit",
          "network"
        ]
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "type": "array",
            "contains": {
              "const": "document.edit"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "then": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "document.read"
            }
          }
        }
      }
    }
  ]
}
